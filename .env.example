# Copy to .env.local for local development and add the same keys in Vercel → Settings → Environment Variables.

# ── Lead form delivery (set at least one, otherwise the form falls back to WhatsApp) ──
# Email via Resend (https://resend.com). LEAD_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Brandraize Website <info@brandraize.com>"
LEAD_TO_EMAIL=info@brandraize.com
# Or POST every lead as JSON to a webhook (Zapier, Make, Google Sheets Apps Script, CRM…).
LEAD_WEBHOOK_URL=

# ── Search engines ──
# Google Search Console → Add property → URL prefix → "HTML tag": paste only the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Ads & analytics (each tag loads only when its ID is set) ──
# Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Or load Google tags directly, comma separated, e.g. G-XXXXXXX,AW-123456789
NEXT_PUBLIC_GOOGLE_TAG_IDS=
# Google Ads conversion to fire on a submitted lead form, e.g. AW-123456789/AbCdEfGhIj
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook / Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── AI assistant (the robot chat in the corner) ──
# Anthropic API key from https://platform.claude.com → API keys. Without it the robot shows a WhatsApp fallback.
ANTHROPIC_API_KEY=
# Optional: the Claude model to answer with (default claude-opus-5-5; claude-haiku-5-5 is much cheaper).
CHAT_MODEL=
